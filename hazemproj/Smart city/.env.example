ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Plate inference: only ROBOFLOW_USE_WORKFLOW=1 uses workflows; anything else uses direct model.
ROBOFLOW_USE_WORKFLOW=0
ROBOFLOW_MODEL_ID=tunisian-license-plate-9umhi-26wmt/1
ROBOFLOW_CONFIDENCE=0.4
ROBOFLOW_OVERLAP=0.3
# OCR backend for plate text extraction: auto|anpr|easyocr|tesseract
OCR_BACKEND=auto
# OCR_EASYOCR_LANGS=en,ar
# Optional default image for test_direct.py when no CLI arg (not used by web_app.py)
# ROBOFLOW_TEST_IMAGE=C:\path\to\image.jpg
# Optional class filter for plate boxes (empty = all). Plate-only models often leave this unset.
# ROBOFLOW_PLATE_OUTPUT_CLASSES=

# --- Workflow path (set ROBOFLOW_USE_WORKFLOW=1) ---
# ROBOFLOW_USE_WORKFLOW=1
# ROBOFLOW_WORKSPACE=homerbot
# ROBOFLOW_WORKFLOW_ID=detect-and-classify-6
# ROBOFLOW_IMAGE_INPUT_NAME=image
# ROBOFLOW_USE_SDK=http
# ROBOFLOW_PLATE_OUTPUT_CLASSES=car-license-plate
# ROBOFLOW_DEBUG_SAVE_LAST=0
# ROBOFLOW_PLATE_CLASSES=car-license-plate
# ROBOFLOW_CLASSES_PARAM=classes
