# Copier vers .env à la racine du dépôt smartcity (chargé par Django config/settings.py).

# UAV / Drone CNN (best_CNN.keras) — chemin absolu ou relatif à la racine du projet
# UAV_MODEL_PATH=models/best_CNN.keras

# Geocoding mobile app (Nominatim / OpenStreetMap)
# GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODING_USER_AGENT=MedinaMind/1.0 (smartcity)

# Caméra feu ONNX (optionnel — défaut : models/best.onnx puis assets/models/best.onnx)
# FIRE_ONNX_MODEL=D:\chemin\absolu\vers\best.onnx
# DRONE_HOST=192.168.0.148

# Twilio — alertes vocales (page /fire-camera/detect/)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_TO=
# TWILIO_ALERT_MESSAGE=
# YOLO_CLASS_NAMES=feu,fumée
# TWILIO_FIRE_CLASS_IDS=0,1

# OpenAI — AI dashboard chat assistant (POST /ai-dashboard/api/chat/)
# Server-side only — set locally in .env and on Vercel as OPENAI_API_KEY
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Groq — AI Orb voice assistant (POST /api/assistant/groq/)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
