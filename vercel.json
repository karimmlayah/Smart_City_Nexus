{
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "bash build_files.sh",
  "functions": {
    "config/wsgi.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}
